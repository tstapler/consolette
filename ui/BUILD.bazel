load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_run_binary")
load("@npm//:defs.bzl", "npm_link_all_packages")

package(default_visibility = ["//visibility:public"])

npm_link_all_packages(name = "node_modules")

# Inputs mirror build.rs's UI_INPUTS; Bazel tracks them hermetically.
_UI_SRCS = glob(["src/**", "public/**"]) + [
    "angular.json",
    "package.json",
    "tsconfig.json",
    "tsconfig.app.json",
]

js_library(
    name = "ui_srcs",
    srcs = _UI_SRCS,
)

# Wraps `ng build` so it also works in the sandbox (see the script header).
js_binary(
    name = "ng_build",
    entry_point = "bazel_ng_build.mjs",
)

js_run_binary(
    name = "dashboard",
    srcs = [
        ":node_modules",
        ":ui_srcs",
    ],
    args = ["dist/consolette"],
    chdir = package_name(),
    out_dirs = ["dist/consolette"],
    tool = ":ng_build",
)
